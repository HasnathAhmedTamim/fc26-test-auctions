# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/fc26-auction?retryWrites=true&w=majority&appName=Cluster0
# Local custom server only (npm run dev). If querySrv ECONNREFUSED on Windows:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# NextAuth (generate with: openssl rand -hex 32)
AUTH_SECRET=replace-with-a-long-random-string

# --- Local development ---
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Production (live auction — use Render/Railway, NOT Vercel-only) ---
# Deploy with: npm run build && npm start (see render.yaml or railway.toml)
# AUTH_URL=https://your-app.onrender.com
# NEXT_PUBLIC_APP_URL=https://your-app.onrender.com
# Optional override if socket runs on a different origin:
# NEXT_PUBLIC_SOCKET_URL=https://your-app.onrender.com

# --- Vercel (pages/API only — live auction will NOT work) ---
# AUTH_URL=https://fc26-test-auctions.vercel.app
# NEXT_PUBLIC_APP_URL=https://fc26-test-auctions.vercel.app

# Optional legacy fallbacks
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=replace-with-a-long-random-string

# Optional contact number (leave unset to hide WhatsApp links)
# NEXT_PUBLIC_WHATSAPP_NUMBER=
